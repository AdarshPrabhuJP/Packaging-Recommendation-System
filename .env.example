# PostgreSQL Database Configuration
# Copy this file to .env and fill in your actual credentials

# Database host (usually localhost for local development)
DB_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database name (create this database in PostgreSQL first)
DB_NAME=packaging_recommendation_db

# Database user (default is usually 'postgres')
DB_USER=postgres

# Database password (set this to your PostgreSQL password)
DB_PASSWORD=your_password_here

# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Replace 'your_password_here' with your actual PostgreSQL password
# 3. Adjust other settings if needed (host, port, database name, user)
# 4. Make sure the database exists in PostgreSQL before running scripts
